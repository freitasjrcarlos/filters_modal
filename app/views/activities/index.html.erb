<% content_for :title, "Activities" %>

<div data-controller="filters-modal">
<script type="application/json" id="users-data">
<%= raw @users.map { |user| { id: user.id, name: user.name } }.to_json %>
</script>

<h1>Atividades</h1>

<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<div class="flex-between mb-2">
  <%= link_to "Nova atividade", new_activity_path, class: "btn btn-primary" %>

  <button data-action="click->filters-modal#openModal" class="btn btn-outline-primary">
    🔽 Filtrar
  </button>
</div>

<!-- Active filters -->
<% if params[:groups].present? %>
  <div class="active-filters mb-3">
    <div class="active-filters-header">
      <h4 class="active-filters-title">🎯 Filtros Ativos</h4>
      <%= link_to "🗑️ Limpar Todos", activities_path, class: "btn btn-sm btn-outline-danger" %>
    </div>
    
    <div class="active-filters-list">
      <% params[:groups].each do |group_id, group| %>
        <% if group[:filters].present? %>
          <div class="filter-group">
            <span class="filter-group-label">Grupo <%= group_id %>:</span>
            <% group[:filters].each do |filter_id, filter| %>
              <% if filter[:field].present? && filter[:value].present? %>
                <div class="filter-tag">
                  <span class="filter-tag-content">
                    <strong><%= get_field_display_name(filter[:field]) %></strong>
                    <%= get_operator_display_name(filter[:operator]) %>
                    <em>"<%= filter[:value] %>"</em>
                  </span>
                  <%= button_to "×", remove_filter_path, 
                      method: :delete,
                      params: { group_id: group_id, filter_id: filter_id },
                      class: "filter-tag-remove", 
                      data: { confirm: "Remover este filtro?" },
                      form_class: "filter-remove-form" %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="table-container">
  <table class="table">
    <%= render_table_header(@table_columns) %>
    <tbody>
      <% @activities.each do |activity| %>
        <tr>
          <% @table_columns.each do |column| %>
            <%= render_table_cell(activity, column) %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'shared/pagination' %>

<!-- Filters Modal -->
<%= render 'shared/filters_modal' %>
</div>