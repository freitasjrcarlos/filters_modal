<p style="color: green"><%= notice %></p>

<%= render @activity %>

<div class="flex gap-2">
  <%= link_to "Editar", edit_activity_path(@activity), class: "btn btn-primary" %>
  <%= link_to "Voltar", activities_path, class: "btn btn-secondary" %>
  <%= button_to "Deletar", @activity, method: :delete, class: "btn btn-danger", data: { confirm: "Tem certeza que deseja deletar esta atividade?" } %>
</div>
