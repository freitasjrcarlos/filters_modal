<div class="filters-modal" data-filters-modal-target="modal" data-action="click->filters-modal#closeModalOnBackdrop">
  <div class="filters-modal-content">
    <div class="filters-modal-header">
      <h3 class="filters-modal-title">Filtrar indicador</h3>
      <button data-action="click->filters-modal#closeModal" class="filters-modal-close">
        <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= search_form_for @q, url: activities_path, method: :get, local: true, 
        data: { controller: "filters-modal" } do |f| %>
      
      <div class="filters-container">
        <!-- Grupo 1 -->
        <div class="filters-block" data-group-id="group_1">
          <div class="filters-left-section">
            <div class="filters-where-block">
              <div class="filters-where-label">Onde</div>
            </div>
            <div class="filters-operator-block" id="operator-block-group_1" style="display: none;">
              <select name="q[g][0][m]" class="filters-operator-select operator-editable" data-action="change->filters-modal#updateGroupOperator">
                <option value="and">E</option>
                <option value="or">OU</option>
              </select>
            </div>
          </div>
          
          <div class="filters-right-section">
            <div class="filters-group" data-group-id="group_1" id="group-group_1">
              <div class="filters-group-header">
                <h4 class="filters-group-title">📋 Grupo 1</h4>
              </div>
              
              <div class="filters-group-operator-section">
                <label class="filters-label">Operador entre filtros:</label>
                <select name="q[g][0][c][m]" class="filter-operator filters-select" data-action="change->filters-modal#updateFilterOperator" id="operator-group_1">
                  <option value="and">E</option>
                  <option value="or">OU</option>
                </select>
              </div>
              
              <div class="filters-container" id="filters-container-group_1">
                <!-- Render Filters -->
              </div>
              
              <button type="button" class="filters-btn filters-btn-outline-primary" data-action="click->filters-modal#addFilter" id="add-filter-group_1">
                ➕ Adicionar filtro agrupado
              </button>
            </div>
          </div>
        </div>
        
        <div data-filters-modal-target="groupContainer">
          <!-- Render Groups -->
        </div>
      </div>

      <div class="filters-actions">
        <div class="filters-actions-left">
          <button type="button" class="filters-btn filters-btn-success" data-action="click->filters-modal#addGroup">
            ➕  Adicionar filtro
          </button>
        </div>
        
        <div class="filters-actions-right">          
          <button type="button" class="filters-btn filters-btn-secondary" data-action="click->filters-modal#clearFilters">
            Limpar Filtros
          </button>
          <button type="button" class="filters-btn filters-btn-primary" data-action="click->filters-modal#applyFilters">
           Aplicar Filtros
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- User Data for JavaScript -->
<script type="application/json" id="users-data">
  <%= @users.map { |u| { id: u.id, name: u.name } }.to_json.html_safe %>
</script>

<!-- Filterable Fields Data for JavaScript -->
<script type="application/json" id="filterable-fields-data">
  <%= @filterable_fields.to_json.html_safe %>
</script>
